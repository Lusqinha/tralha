# Private port: API, MCP, uploads and the panel. Keep it reachable only from your network or VPN.
TRALHA_PORT=8000
TRALHA_API_URL=http://tralha.lan:8000

# Public port: only /p/ and /b/. This is the only one that should face the internet.
TRALHA_PUBLIC_PORT=8001
TRALHA_PUBLIC_URL=https://files.example.com

# Proxies trusted to send X-Forwarded-* headers. Use your reverse proxy's IP.
TRALHA_FORWARDED_ALLOW_IPS=127.0.0.1

# Without this line the database is SQLite at /data/tralha.db. For Postgres, use the same password in both lines.
# TRALHA_DATABASE_URL=postgresql+psycopg://tralha:change-me@postgres/tralha
# POSTGRES_PASSWORD=change-me

TRALHA_MAX_UPLOAD_MB=25
TRALHA_UPLOAD_TTL=600
TRALHA_GC_INTERVAL=3600
