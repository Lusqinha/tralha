# Private port: API, MCP, uploads and the panel. Every request needs a key or a panel session.
TRALHA_PORT=8000
TRALHA_API_URL=http://localhost:8000

# Public port: only /p/ and /b/.
TRALHA_PUBLIC_PORT=8001
TRALHA_PUBLIC_URL=http://localhost:8001

# On a VPS with the bundled Caddy (docker compose --profile proxy up -d), use your
# domains instead. Caddy gets the HTTPS certificates on its own.
# TRALHA_API_URL=https://api.example.com
# TRALHA_PUBLIC_URL=https://files.example.com
# TRALHA_API_DOMAIN=api.example.com
# TRALHA_FILES_DOMAIN=files.example.com

# Proxies trusted to send X-Forwarded-* headers. 172.30.0.0/24 is the compose network,
# so this trusts the bundled Caddy. Use 127.0.0.1 when the proxy runs on the host.
TRALHA_FORWARDED_ALLOW_IPS=172.30.0.0/24

# Optional: only these IPs or networks can open /admin, for example your home IP and Tailscale.
# TRALHA_ADMIN_ALLOWED_IPS=203.0.113.7,100.64.0.0/10

# Serve the OpenAPI docs at /api/docs. Leave it off in production.
# TRALHA_API_DOCS=true

# Without this line the database is SQLite at /data/tralha.db. For Postgres, use the same password in both lines.
# TRALHA_DATABASE_URL=postgresql+psycopg://tralha:change-me@postgres/tralha
# POSTGRES_PASSWORD=change-me

TRALHA_MAX_UPLOAD_MB=25
TRALHA_UPLOAD_TTL=600
TRALHA_GC_INTERVAL=3600
